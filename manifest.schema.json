{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attest.ariaxhan.workers.dev/manifest.schema.json",
  "title": "Attest intent manifest",
  "type": "object",
  "required": ["task", "principal", "agent", "scope", "evidence_required"],
  "properties": {
    "task": { "type": "string", "minLength": 1, "maxLength": 512 },
    "principal": { "type": "string", "minLength": 1, "maxLength": 512 },
    "agent": { "type": "string", "minLength": 1, "maxLength": 512 },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "evidence_required": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "change_class": { "enum": ["production deploy", "deletion", "policy change"] }
  },
  "additionalProperties": false
}
